{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "three": ["./node_modules/@types/three"],
      "three/*": ["./node_modules/@types/three/*"]
    },
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
